// Stammdaten-Kernschema — DBML-Ansicht von stammdaten-schema.sql, nur für die
// Visualisierung (z. B. dbdiagram.io). Quelle der Wahrheit ist die .sql-Datei;
// bei Abweichung gewinnt die SQL. Kommentare hier stark gekürzt gegenüber dort.
//
// Diese Datei ist die einzige von Hand gepflegte Zweitdarstellung des Schemas und
// damit die, die still danebenlaufen kann. Nach jeder Schemaänderung den
// Spaltensatz gegenprüfen — schweigt bei Deckungsgleichheit, listet sonst die
// Abweichung und liefert Exit-Code 1:
//   diff <(awk '/^CREATE TABLE/{t=$3; next} /^\);/{t=""} t && /^    [a-z_]+ /{print t"."$1}' \
//              domains/stammdaten-schema-plain.sql | sort) \
//        <(awk '/^Table /{t=$2; next} /^}/{t=""} t && /^  [a-z_]+ /{if ($1!="indexes") print t"."$1}' \
//              domains/stammdaten-schema.dbml | sort)
// Prüft Tabellen und Spalten, nicht die Note:-Texte — Prosa-Drift ist hier
// verkraftbar, eine fehlende Spalte nicht.

Project stammdaten {
  database_type: 'PostgreSQL'
}

// ---------------------------------------------------------------------------
// Lookup-Tabellen
// ---------------------------------------------------------------------------

Table genders {
  id    integer [pk, increment]
  label text    [not null, unique]
  code  text    [not null, unique]
  Note: 'Amtliches Merkmal für ASV-BW/Statistik, deshalb stabiler code neben dem umbenennbaren label. ISO 5218 geprüft und verworfen — die Norm (0/1/2/9) kann "divers" nicht ausdrücken (§22 Abs. 3 PStG); Werte stammen aus der ASV-BW-Werteliste.'
}

Table salutations {
  id    integer [pk, increment]
  label text    [not null, unique]
  Note: 'Anrede — bewusst getrennt vom Geschlecht, nicht daraus abgeleitet.'
}

Table academic_titles {
  id    integer [pk, increment]
  label text    [not null, unique]
}

Table guardian_categories {
  id    integer [pk, increment]
  label text    [not null, unique]
  Note: 'z.B. Elternteil, Pflegeeltern, Jugendamt — hängt an family_guardians, nicht am Guardian.'
}

Table denominations {
  id    integer [pk, increment]
  label text    [not null, unique]
}

Table languages {
  id    integer [pk, increment]
  label text    [not null, unique]
  code  text    [not null, unique]
  Note: 'Verkehrssprache. Lookup statt Freitext: speist den ASV-BW-Export, dort zählt ein konsistenter Wert. code = BCP 47, CHECK auf Grundform mit kanonisch kleingeschriebenem Primär-Subtag. Liste wird geseedet, label bleibt frei änderbar, code nicht (externer Standard).'
}

Table countries {
  id    integer [pk, increment]
  label text    [not null, unique]
  code  text    [not null, unique]
  Note: 'Land für Anschrift/Geburtsland/Staatsangehörigkeit. Lookup statt ISO-Code-Freitext: der Weg nach ASV-BW läuft über einen CSV-Export mit manueller Nacharbeit — der label trägt die Sichtprüfung, der code die maschinelle Seite (ein Export auf Basis der umbenennbaren Bezeichnung bricht still). ASV-BW führt die Werte selbst als Werteliste, nicht als ISO-Code. code = ISO 3166-1 alpha-3 (nicht alpha-2: das wird neu vergeben und kollidiert optisch mit languages.code), mit Format-CHECK. Liste wird aus ISO 3166-1 geseedet, label bleibt frei änderbar, code nicht (externer Standard).'
}

Table phone_types {
  id    integer [pk, increment]
  label text    [not null, unique]
}

Table school_branches {
  id    integer [pk, increment]
  label text    [not null, unique]
}

Table grade_levels {
  id               integer  [pk, increment]
  school_branch_id integer  [not null]
  label            text     [not null]
  sort_order       smallint [not null]
  is_final_grade   boolean  [not null, default: false]
  created_at       timestamptz [not null, default: `now()`]
  created_by       text     [not null]
  updated_at       timestamptz [not null, default: `now()`]
  updated_by       text     [not null]

  indexes {
    (school_branch_id, label) [unique]
    (school_branch_id, sort_order) [unique]
    (id, school_branch_id) [unique]
    (school_branch_id) [unique, name: 'one_final_grade_per_branch']
  }
  Note: '(id, school_branch_id): Ziel des zusammengesetzten FK von classes — hält classes.school_branch_id konsistent zur aktuellen Klassenstufe. one_final_grade_per_branch ist in echt partiell (WHERE is_final_grade): höchstens eine Abschlussklasse je Zweig, sonst sperrt die Putzdienst-Abgangsregel still den September für Familien, die noch bleiben.'
}

Table classes {
  id               integer  [pk, increment]
  school_branch_id integer  [not null]
  grade_level_id   integer  [not null]
  entry_year       smallint [not null]
  stream           text     [not null, note: 'CHECK <> \'\'']
  is_active        boolean  [not null, default: true, note: 'false = Kohorte durch oder Zug aufgelöst; Zeile bleibt für die Akte, zählt nirgends mehr als Klasse mit']
  class_teacher_id uuid     [note: 'FK auf employees, in SQL per ALTER TABLE nachgezogen — Definitionsreihenfolge']
  room             text
  created_at       timestamptz [not null, default: `now()`]
  created_by       text     [not null]
  updated_at       timestamptz [not null, default: `now()`]
  updated_by       text     [not null]

  indexes {
    (school_branch_id, entry_year, stream) [unique]
    class_teacher_id
  }
  Note: 'Kohorte, nicht Klassenstufen-Slot: Zeile = ein Zug eines Jahrgangs im Zweig (Zweig/Eintrittsjahr/Zug). Stabil ist die Zeile, nicht ihre Besetzung — Quereinsteiger kommen dazu, Abgänger fallen weg, Wiederholer wechseln die Kohorte. entry_year ist das Startjahr der Kohorte, der Eintritt des Kindes steht als children.entry_date. grade_level_id ist die AKTUELLE Klassenstufe, wandert beim Jahreslauf auf derselben Zeile weiter, bei einer durchgelaufenen Kohorte bleibt sie auf der Abschlussstufe stehen und is_active wird false. Anzeigename ("5a") und Kohorten-Kennung ("RS25a") werden berechnet, nicht gespeichert.'
}

Table previous_schools {
  id    integer [pk, increment]
  label text    [not null, unique]
  Note: 'Abgebende Schule; steht auf dem Grundschul- wie dem Realschul-Voranmeldeformular.'
}

// ---------------------------------------------------------------------------
// Anschrift
// ---------------------------------------------------------------------------

Table addresses {
  id           uuid        [pk, default: `gen_random_uuid()`]
  street       text
  house_number text
  district     text
  postal_code  text
  city         text
  country_id   integer     [not null]
  created_at   timestamptz [not null, default: `now()`]
  created_by   text        [not null]
  updated_at   timestamptz [not null, default: `now()`]
  updated_by   text        [not null]

  indexes {
    (postal_code, street, house_number)
  }
  Note: 'Eigene Tabelle statt Spalten je Person: Kind + Eltern teilen sich im Regelfall eine Zeile. Suchindex nötig, damit die Eingabemaske bestehende Zeilen findet — sonst verwaist das Konzept in der Praxis.'
}

// ---------------------------------------------------------------------------
// Personen und Organisationen
// ---------------------------------------------------------------------------

Table persons {
  id                uuid        [pk, default: `gen_random_uuid()`]
  salutation_id     integer
  academic_title_id integer
  first_name        text
  last_name         text        [not null, note: 'CHECK <> \'\'']
  gender_id         integer
  address_id        uuid
  email             citext
  created_at        timestamptz [not null, default: `now()`]
  created_by        text        [not null]
  updated_at        timestamptz [not null, default: `now()`]
  updated_by        text        [not null]

  indexes {
    address_id
    email
    `lower(last_name)` [name: 'persons_last_name_pattern_idx']
  }
  Note: 'Gemeinsame Basis jeder natürlichen Person. Kind/Guardian/Kontakt/Zahler sind Rollen darauf, keine eigenen Personentabellen. email: Struktur-CHECK (genau ein @, kein Leerzeichen, Punkt in der Domain — fängt Leerstring und Import-Artefakte), bewusst NICHT unique — zwei Erziehungsberechtigte dürfen sich eine Mailbox teilen, ein OTP-Treffer (idea/04) liefert dann die Vereinigung ihrer Familien. Eigener Index, da kein Constraint ihn mehr anlegt. last_name-Index in echt text_pattern_ops für Präfixsuche, hier nur als Ausdrucksindex angenähert.'
}

Table organizations {
  id         uuid        [pk, default: `gen_random_uuid()`]
  name       text        [not null, note: 'CHECK <> \'\'']
  address_id uuid
  email      citext
  created_at timestamptz [not null, default: `now()`]
  created_by text        [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by text        [not null]

  indexes {
    address_id
  }
  Note: 'Erziehungsberechtigte als Organisation (Jugendamt, Pflegedienst, Vereinsvormund). email: rein ausgehender Kanal (Schule schreibt die Behörde an), bewusst NICHT unique — kein Login daran, die OTP-Prüfung liest nur persons.email. Struktur-CHECK auf email analog persons.'
}

Table phone_numbers {
  id              uuid        [pk, default: `gen_random_uuid()`]
  person_id       uuid
  organization_id uuid
  phone_type_id   integer     [not null]
  number          text        [not null, note: 'CHECK <> \'\'']
  is_primary      boolean     [not null, default: false]
  note            text
  created_at      timestamptz [not null, default: `now()`]
  created_by      text        [not null]
  updated_at      timestamptz [not null, default: `now()`]
  updated_by      text        [not null]

  indexes {
    (person_id, number) [unique]
    (organization_id, number) [unique]
    (person_id) [unique, name: 'one_primary_per_person']
    (organization_id) [unique, name: 'one_primary_per_org']
  }
  Note: 'Gehört entweder zu Person ODER Organisation (CHECK in SQL). is_primary: die von der Person benannte Rufnummer, genutzt für O365-Kontakte; one_primary_* sind in echt partiell (WHERE is_primary AND … IS NOT NULL). Dieselbe Nummer nur einmal je Eigentümer — der Typ ist eine Eigenschaft der Nummer, nicht ihre Identität; diese beiden Unique-Indizes tragen zugleich den Zugriff über person_id bzw. organization_id allein, ein einspaltiger Index daneben wäre redundant.'
}

// ---------------------------------------------------------------------------
// Familie, Kind, Erziehungsberechtigte
// ---------------------------------------------------------------------------

Table families {
  id         uuid        [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  created_by text        [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by text        [not null]

  Note: 'Sorgerecht-Konstellation, nicht Haushalt. Manuell gepflegt, kein Bezeichnungsfeld.'
}

Table children {
  id                          uuid    [pk]
  family_id                   uuid
  nickname                    text
  date_of_birth               date    [not null]
  birthplace                  text
  birth_country_id            integer
  nationality_id              integer
  second_nationality_id       integer
  home_language_id            integer
  denomination_id             integer
  congregation                text
  provisional_grade_level_id  integer
  class_id                    integer
  registration_date           date
  entry_date                  date
  exit_date                   date
  previous_school_id          integer
  previous_school_consent_at  timestamptz
  created_at                  timestamptz [not null, default: `now()`]
  created_by                  text    [not null]
  updated_at                  timestamptz [not null, default: `now()`]
  updated_by                  text    [not null]

  indexes {
    family_id
    class_id
    provisional_grade_level_id
  }
  Note: 'children.id = persons.id (Kind IST eine Person). provisional_grade_level_id UND class_id schließen sich per CHECK gegenseitig aus (keine Redundanz, die auseinanderlaufen könnte) — ist eine Klasse zugeteilt, kommt die aktuelle Klassenstufe per Join aus classes.grade_level_id. second_nationality_id: nur mit gesetzter nationality_id und nicht derselbe Staat (CHECK). denomination_id/congregation: Art.-9-Daten, geschützt per Spalten-GRANT, rollenspezifisch (auch auf guardians, nicht auf persons).'
}

Table guardians {
  id              uuid    [pk, default: `gen_random_uuid()`]
  person_id       uuid    [unique]
  organization_id uuid    [unique]
  occupation      text
  denomination_id integer
  congregation    text
  created_at      timestamptz [not null, default: `now()`]
  created_by      text    [not null]
  updated_at      timestamptz [not null, default: `now()`]
  updated_by      text    [not null]

  Note: 'Entweder natürliche Person ODER Organisation (CHECK in SQL). Bewusst kein is_employee-Flag — die Mitarbeitereigenschaft steht an employees und ist von dort ableitbar; die Putzdienst-Befreiung fragt „aktuell beschäftigt", nicht „war mal". denomination_id/congregation nur bei natürlicher Person (CHECK).'
}

Table family_guardians {
  family_id            uuid    [not null]
  guardian_id          uuid    [not null]
  guardian_category_id integer
  include_in_correspondence boolean [not null, default: true, note: '„In Briefe miteinbeziehen" — steht auf allen vier Anmeldetag-Checklisten neben „Sorgeberechtigt"']
  contact_person       text
  created_at           timestamptz [not null, default: `now()`]
  created_by           text    [not null]
  updated_at           timestamptz [not null, default: `now()`]
  updated_by           text    [not null]

  indexes {
    (family_id, guardian_id) [pk]
    guardian_id
  }
  Note: 'M:N Guardian↔Familie (Patchwork). Grundlage des OTP-Ownership-Checks. contact_person nur bei Organisation als Guardian, durchgesetzt per Trigger (kein CHECK möglich, cross-table).'
}

// ---------------------------------------------------------------------------
// Mitarbeiter
// ---------------------------------------------------------------------------

Table employees {
  id               uuid        [pk]
  work_email       citext      [unique]
  entra_object_id  text        [unique, note: 'CHECK <> \'\'']
  employment_start date
  employment_end   date
  created_at       timestamptz [not null, default: `now()`]
  created_by       text        [not null]
  updated_at       timestamptz [not null, default: `now()`]
  updated_by       text        [not null]
  Note: 'Rolle auf persons (id = persons.id), immer natürliche Person. work_email getrennt von persons.email: Letztere ist privat und zugleich OTP-Identität — ein Mitarbeiter, der auch Elternteil ist, verlöre sonst beim Offboarding seinen Elternzugang. Hier UNIQUE, weil die Schule diese Postfächer selbst vergibt. entra_object_id verbindet den Audit-Verursacher "entra:<oid>" mit der Person und trägt die Zugriffsentscheidung "ist Klassenlehrer:in dieser Klasse". employment_end gesetzt = ausgeschieden; die Putzdienst-Befreiung fragt employment_end IS NULL. Bereichs-/Vorgesetztenstruktur bewusst noch nicht enthalten (erst mit der Rechnungsfreigabe).'
}

// ---------------------------------------------------------------------------
// Kontakte (nicht-rechtliche Bezugspersonen)
// ---------------------------------------------------------------------------

Table contacts {
  id         uuid [pk]
  note       text
  created_at timestamptz [not null, default: `now()`]
  created_by text [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by text [not null]

  Note: 'contacts.id = persons.id. Notfallkontakt/Abholberechtigt ohne Rechtsstellung, kein Login.'
}

Table child_contacts {
  child_id     uuid [not null]
  contact_id   uuid [not null]
  relationship text
  priority     smallint
  created_at   timestamptz [not null, default: `now()`]
  created_by   text [not null]
  updated_at   timestamptz [not null, default: `now()`]
  updated_by   text [not null]

  indexes {
    (child_id, contact_id) [pk]
    contact_id
    (child_id, priority) [unique, name: 'one_priority_rank_per_child']
  }
  Note: 'relationship ("Großmutter") relativ zum Kind, nicht absolut zur Kontaktperson — Freitext, anders als guardian_categories: langer Wertevorrat-Schwanz, niemand wertet danach aus. priority: Notfallkontakt-Reihenfolge, nullable, höchstens einmal je Kind belegt.'
}

Table payers {
  id                 uuid    [pk, default: `gen_random_uuid()`]
  person_id          uuid    [unique]
  organization_id    uuid    [unique]
  billing_address_id uuid
  iban               text
  bic                text
  account_holder     text
  mandate_reference  text        [unique]
  mandate_signed_at  date
  created_at         timestamptz [not null, default: `now()`]
  created_by         text [not null]
  updated_at         timestamptz [not null, default: `now()`]
  updated_by         text [not null]

  indexes {
    billing_address_id
  }
  Note: 'Entweder natürliche Person ODER Organisation (CHECK in SQL, wie guardians). billing_address_id nullable: NULL = Anschrift der zahlenden Person/Organisation gilt. iban/bic: Struktur-CHECK nach ISO 13616 bzw. ISO 9362 (international, nicht auf deutsche Längen festgelegt); gespeichert nur normalisiert, ohne Leerzeichen. SEPA-Mandat: ein Mandat je Zahler, nicht je Zweck; mandate_reference und mandate_signed_at nur gemeinsam und nie ohne iban (CHECKs in SQL). Kein Kreditinstitut (folgt aus der BIC), keine Mandatshistorie; das signierte PDF liegt in der Schulvertrags-Fachdomäne und trägt kein eigenes Datum.'
}

Table child_payers {
  child_id   uuid    [not null]
  payer_id   uuid    [not null]
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  created_by text [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by text [not null]

  indexes {
    (child_id, payer_id) [pk]
    payer_id
    (child_id) [unique, name: 'one_primary_payer_per_child']
  }
  Note: 'M:N, mehrere Zahler je Kind (Bezuschussung). is_primary: Hauptzahler:in, analog phone_numbers.is_primary.'
}

// ---------------------------------------------------------------------------
// Beziehungen
// ---------------------------------------------------------------------------

Ref: grade_levels.school_branch_id > school_branches.id [delete: restrict]
Ref: classes.school_branch_id > school_branches.id [delete: restrict]
Ref: classes.(grade_level_id, school_branch_id) > grade_levels.(id, school_branch_id)

Ref: persons.salutation_id > salutations.id [delete: restrict]
Ref: persons.academic_title_id > academic_titles.id [delete: restrict]
Ref: persons.gender_id > genders.id [delete: restrict]
Ref: persons.address_id > addresses.id [delete: restrict]

Ref: addresses.country_id > countries.id [delete: restrict]

Ref: organizations.address_id > addresses.id [delete: restrict]

Ref: phone_numbers.person_id > persons.id [delete: cascade]
Ref: phone_numbers.organization_id > organizations.id [delete: cascade]
Ref: phone_numbers.phone_type_id > phone_types.id [delete: restrict]

Ref: children.id - persons.id [delete: cascade]
Ref: children.family_id > families.id [delete: restrict]
Ref: children.denomination_id > denominations.id [delete: restrict]
Ref: children.home_language_id > languages.id [delete: restrict]
Ref: children.birth_country_id > countries.id [delete: restrict]
Ref: children.nationality_id > countries.id [delete: restrict]
Ref: children.second_nationality_id > countries.id [delete: restrict]
Ref: children.provisional_grade_level_id > grade_levels.id [delete: restrict]
Ref: children.previous_school_id > previous_schools.id [delete: restrict]
Ref: children.class_id > classes.id [delete: restrict]

Ref: guardians.person_id - persons.id [delete: restrict]
Ref: guardians.organization_id - organizations.id [delete: restrict]
Ref: guardians.denomination_id > denominations.id [delete: restrict]

Ref: family_guardians.family_id > families.id [delete: cascade]
Ref: family_guardians.guardian_id > guardians.id [delete: cascade]
Ref: family_guardians.guardian_category_id > guardian_categories.id [delete: restrict]

Ref: contacts.id - persons.id [delete: cascade]

Ref: child_contacts.child_id > children.id [delete: cascade]
Ref: child_contacts.contact_id > contacts.id [delete: cascade]

Ref: payers.person_id - persons.id [delete: restrict]
Ref: payers.organization_id - organizations.id [delete: restrict]
Ref: payers.billing_address_id > addresses.id [delete: restrict]

Ref: child_payers.child_id > children.id [delete: restrict]
Ref: child_payers.payer_id > payers.id [delete: cascade]
Ref: employees.id - persons.id [delete: cascade]
Ref: classes.class_teacher_id > employees.id [delete: restrict]
